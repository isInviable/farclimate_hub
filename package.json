{
  "name": "farclimate",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "supabase:bootstrap": "pnpm --filter @farclimate/supabase-setup run bootstrap",
    "db:create": "pnpm --filter @farclimate/db run db:create",
    "db:drop": "pnpm --filter @farclimate/db run db:drop",
    "db:truncate": "pnpm --filter @farclimate/db run db:truncate",
    "db:push": "pnpm --filter @farclimate/db run db:push",
    "db:reset": "pnpm --filter @farclimate/db run db:reset",
    "db:backup": "bash scripts/backup-remote-db.sh",
    "cordis:download": "pnpm --filter @farclimate/cordis run cordis:download",
    "cordis:parse": "pnpm --filter @farclimate/cordis run cordis:parse",
    "cordis:create": "pnpm --filter @farclimate/cordis run cordis:create",
    "cordis:push": "pnpm --filter @farclimate/cordis run cordis:push",
    "cordis:audit": "pnpm --filter @farclimate/cordis run cordis:audit",
    "cordis:audit-quality": "pnpm --filter @farclimate/cordis run cordis:audit-quality",
    "cordis:drift": "pnpm --filter @farclimate/cordis run cordis:drift"
  }
}
